{
  "expo": {
    "name": "CampusX",
    "slug": "campusx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "campusx",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFAFE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.campusx.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusX uses your location for campus maps, nearby friends, and local weather only when you allow it.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CampusX uses your location in the background to share your live location with friends on the map, even when the app is closed.",
        "NSCameraUsageDescription": "CampusX uses the camera to scan CampusX QR codes and create posts.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "com.campusx.mobile",
      "versionCode": 1,
      "icon": "./assets/branding/campusx-logo-new-transparent.png",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/campusx-logo-new-transparent.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CampusX to scan QR codes and create media."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CampusX to show your campus position, shared friends, and local weather.",
          "locationAlwaysAndWhenInUsePermission": "Allow CampusX to share your live location with friends even when the app is backgrounded.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/campusx-logo-new-transparent.png",
          "color": "#8066FF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow CampusX to use your microphone for audio calls."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "7f33e455-8f40-4cee-8717-b0b95c2004b4"
      }
    },
    "owner": "anand1417"
  }
}
